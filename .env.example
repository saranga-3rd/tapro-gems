# Copy to .env.local (local) or set in the Vercel project (production). Never commit real values.

# --- Brevo (server-side only; never prefix with NEXT_PUBLIC_) ---
BREVO_API_KEY=
# Must be a verified sender in Brevo (Senders, Domains & Dedicated IPs).
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Tapro Gems
# Numeric ID of the Brevo contact list that holds CONFIRMED subscribers only.
# Use a dedicated TEST list in Preview/Development so no real subscriber is ever emailed.
BREVO_NEWSLETTER_LIST_ID=
# Shared secret Brevo sends as "Authorization: Bearer <token>" to /api/newsletter/webhook.
BREVO_WEBHOOK_TOKEN=

# --- Site ---
# Canonical production origin used in confirmation and product links (https, no trailing slash).
SITE_URL=https://www.example.com

# --- Storage ---
# Newsletter data is ONE JSON document:
#   local dev  -> data/newsletter.json (git-ignored)
#   Vercel     -> Upstash Redis (free tier). Add it from the Vercel Marketplace (Storage), which sets
#                 KV_REST_API_URL / KV_REST_API_TOKEN, or set the UPSTASH_REDIS_REST_* pair yourself.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Scheduled worker ---
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/newsletter.
CRON_SECRET=

# --- Existing settings (unchanged) ---
